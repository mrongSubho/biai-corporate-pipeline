{
  "name": "biai-corporate-pipeline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:client": "vite",
    "dev:worker": "wrangler dev",
    "dev": "vite",
    "build:client": "vite build",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "d1:migrate:local": "wrangler d1 migrations apply biai-pipeline-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply biai-pipeline-db --remote",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.7.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "svelte": "^5.20.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.6",
    "wrangler": "^3.111.0"
  }
}
